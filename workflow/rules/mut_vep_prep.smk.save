lambda wildcards: wildcards.studyrule mut_vep_prep:
    input:
        phyclone_results="results/{study}/phyclone/tree_table.tsv"
    output:
        dir=directory("results/{study}/mut_vep_prep")
    params:
        study=lambda wildcards: wildcards.study
    log:
        "logs/{study}/mut_vep_prep/mut_vep_prep.log"
    benchmark:
        "logs/{study}/mut_vep_prep/mut_vep_prep.bmk"
    conda:
        "../envs/mut_vep_prep.yaml"
    threads: 
        config["resources"]["default"]["threads"]
    resources:
        mem_mb = config["resources"]["default"]["mem"],
        runtime=240
    shell:
        """
        python scripts/vep_formatting.py --mut_data {input.phyclone_results} \
                                             --study {params.study} \
                                             --out_dir {output.dir} 2> {log}
        """
