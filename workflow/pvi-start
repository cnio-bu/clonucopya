from snakemake.io import expand, touch
from snakemake.utils import validate
from glob import glob
import os
import pandas as pd
from collections import defaultdict

###### Config file, environment and sample sheet #####

configfile: "../config/config_pvi-start.yaml"

validate(config, "resources/schemas/config_schema_wf2.yaml")

os.environ["SNAKEMAKE_OUTPUT_CACHE"] = f"{os.getcwd()}/resources/vep/cache"

##### Target rules #####

samplesheet = pd.read_csv(config["samplesheet"])

studies = samplesheet.set_index("study", drop=False)

validate(studies, "resources/schemas/samplesheet_schema_wf2.yaml")



study_to_pvi = {}
study_to_samples = defaultdict(set)

for _, row in samplesheet.iterrows():
    study = row["study"]
    pvi_path = row["pyclone_vi"]

    if pd.isna(pvi_path) or pvi_path == "":
        continue

    study_to_pvi[study] = pvi_path

    if not os.path.exists(pvi_path):
        raise FileNotFoundError(f"Missing input file: {pvi_path}")

    pvi_df = pd.read_csv(pvi_path, sep="\t")
    for s in pvi_df["sample_id"].unique():
        study_to_samples[study].add(s)

study_to_samples = {k: sorted(list(v)) for k, v in study_to_samples.items()}

studies = sorted(list(study_to_samples.keys()))

print("Processing studies:", studies)

sphere_clones = []
for study, sample_list in study_to_samples.items():
    for sample in sample_list:
        sphere_clones.append(
            f"results/{study}/report/components/spheres_of_clones/{sample}_sphere_of_clones.png"
        )

rule all:
    input:
        expand("results/{study}/pyclone-vi/pvi_out.tsv", study=samplesheet["study"].unique()),
        "resources/vep/cache",
        expand("results/{study}/phyclone/tree.nwk", study=samplesheet["study"].unique()),
        expand("results/{study}/vep_annotation/annotations", study=samplesheet["study"].unique()),
        expand("results/{study}/query_pandrugs", study=samplesheet["study"].unique()),
        expand("results/{study}/report/components/report_panel_wf2.tsv", study=samplesheet["study"].unique()),
        expand("results/{study}/report/components/clonal_tree.png", study=samplesheet["study"].unique()),
        sphere_clones,
        expand("results/{study}/report/components/gene_alterations_wf2.tsv", study=samplesheet["study"].unique()),
#        expand("results/{study}/report/{study}_report.pdf", study=samples_df["study"].unique())




